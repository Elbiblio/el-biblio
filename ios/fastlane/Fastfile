default_platform(:ios)

platform :ios do
  lane :setup_signing do
    profile_path = File.expand_path("../signing/Elbiblio.mobileprovision")
    
    # Verify profile exists
    unless File.exist?(profile_path)
      UI.user_error!("Provisioning profile not found at #{profile_path}")
    end
    
    profile_uuid = sh("security cms -D -i #{profile_path} | plutil -extract UUID raw -o - -").strip
    profile_name = sh("security cms -D -i #{profile_path} | plutil -extract Name raw -o - -").strip
    team_id = sh("security cms -D -i #{profile_path} | plutil -extract TeamIdentifier.0 raw -o - -").strip
    app_id = sh("security cms -D -i #{profile_path} | plutil -extract Entitlements.application-identifier raw -o - -").strip
    bundle_id = app_id.sub("#{team_id}.", "")
    
    # Verify we extracted valid data
    if profile_uuid.empty? || team_id.empty? || bundle_id.empty?
      UI.user_error!("Failed to extract profile information from provisioning profile at #{profile_path}")
    end

    UI.message("Provisioning profile details:")
    UI.message("  Name: #{profile_name}")
    UI.message("  UUID: #{profile_uuid}")
    UI.message("  Team ID: #{team_id}")
    UI.message("  Application Identifier: #{app_id}")
    UI.message("  Bundle ID: #{bundle_id}")

    profile_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(profile_dir)
    FileUtils.cp(profile_path, "#{profile_dir}/#{profile_uuid}.mobileprovision")
    
    keychain_name = "build.keychain"
    keychain_password = SecureRandom.uuid
    
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 21600,
      lock_when_sleeps: false
    )
    
    import_certificate(
      certificate_path: "signing/distribution.cer",
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )
    
    begin
      import_certificate(
        certificate_path: "signing/ios_dist.p12",
        certificate_password: ENV["IOS_P12_PASSWORD"].to_s,
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
    rescue
      import_certificate(
        certificate_path: "signing/ios_dist.p12",
        certificate_password: "",
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
    end
    
    identities_output = sh("security find-identity -p codesigning -v || true")
    UI.message("Available code signing identities:\n#{identities_output}")

    identity_line = identities_output.lines.find { |l| l.include?("Apple Distribution") }
    unless identity_line
      UI.user_error!("Could not find an 'Apple Distribution' signing identity in the keychain. Ensure ios_dist.p12 contains a valid Apple Distribution certificate with a private key, and that IOS_KEYCHAIN_PASSWORD matches the .p12 export password.")
    end

    identity = identity_line[/[A-F0-9]{40}/]
    if identity.to_s.empty?
      UI.user_error!("Found an 'Apple Distribution' identity line but could not extract SHA-1 hash. Line: #{identity_line}")
    end
    
    { team_id: team_id, bundle_id: bundle_id, profile_name: profile_name, 
      profile_uuid: profile_uuid, identity: identity, keychain: keychain_name }
  end
  
  lane :build_release do
    signing_info = setup_signing
    
    # Detect workspace/project
    workspace = Dir.glob("*.xcworkspace").first
    project = Dir.glob("*.xcodeproj").first
    
    if workspace
      xcode_file = workspace
      UI.message("✓ Using workspace: #{xcode_file}")
    elsif project
      xcode_file = project
      UI.message("✓ Using project: #{xcode_file}")
    else
      UI.user_error!("No Xcode workspace or project found")
    end
    
    build_app(
      workspace: workspace ? xcode_file : nil,
      project: workspace ? nil : xcode_file,
      scheme: "Runner",  # Flutter default scheme
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/export",
      output_name: "Elbiblio.ipa",
      archive_path: "build/App.xcarchive",
      export_options: {
        method: "app-store",
        teamID: signing_info[:team_id],
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false,
        signingStyle: "manual",
        provisioningProfiles: {
          signing_info[:bundle_id] => signing_info[:profile_name]
        }
      },
      xcargs: "DEVELOPMENT_TEAM=#{signing_info[:team_id]} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=#{signing_info[:identity]} PROVISIONING_PROFILE_SPECIFIER=#{signing_info[:profile_uuid]} OTHER_CODE_SIGN_FLAGS='--keychain #{signing_info[:keychain]}'"
    )
  end
  
  lane :upload_testflight do
    key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s
    if key_path.empty?
      UI.message("APP_STORE_CONNECT_API_KEY_PATH not set - skipping TestFlight upload")
    elsif !File.exist?(key_path)
      UI.message("API key file not found at #{key_path} - skipping TestFlight upload")
    else
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APPSTORE_ISSUER_ID"],
        key_filepath: key_path
      )
      
      upload_to_testflight(
        api_key: api_key,
        ipa: "build/export/Elbiblio.ipa",
        skip_waiting_for_build_processing: true
      )
    end
  end
  
  lane :build_and_upload do
    build_release
    upload_testflight
  end
end
