{
  "expo": {
    "name": "El-Biblio",
    "slug": "elbiblio",
    "version": "1.0.21",
    "orientation": "portrait",
    "icon": "./assets/penheart.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ecefef"
    },
    "assetBundlePatterns": [
      "**/*",
      "./assets/bibles/rv.db",
      "./assets/bibles/versions.json",
      "./assets/sounds/streak.wav",
      "./assets/sounds/tick-tock.wav",
      "./assets/sounds/timeout.mp3",
      "./assets/sounds/game-over.mp3",
      "./assets/sounds/correct.mp3",
      "./assets/sounds/cheers.mp3",
      "./assets/sounds/bell.wav",
      "./assets/sounds/chime.wav",
      "./assets/sounds/bell-meditation.mp3",
      "./assets/sounds/success_bell.mp3"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elbiblio.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "El-Biblio uses the microphone to capture audio while recording Face2Face reflections.",
        "NSPhotoLibraryAddUsageDescription": "El-Biblio saves videos/photos to your library when you choose to export Face2Face reflections.",
        "NSPhotoLibraryUsageDescription": "El-Biblio reads photos and videos you select so you can attach and share them.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/penheart.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.elbiblio.app",
      "versionCode": 10021,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/penheart.png"
    },
    "jsEngine": "hermes",
    "plugins": [
      [
        "@livekit/react-native-expo-plugin",
        {
          "iosMicrophonePermission": "Allow El-Biblio to use the microphone so you can speak in Wordhubs.",
          "iosBluetoothPermission": "Allow El-Biblio to use Bluetooth for improved audio during Wordhubs.",
          "androidMicrophonePermission": "Allow El-Biblio to record audio for reflections or Wordhubs."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "useLegacyPackaging": false,
            "reactNativeArchitectures": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "shrinkResources": true,
            "ndk": {
              "version": "26.1.10909125",
              "abiFilters": [
                "arm64-v8a"
              ]
            }
          }
        }
      ],
      "./scripts/expo-config-plugins/withAndroidSigning.js"
    ],
    "extra": {
      "eas": {
        "projectId": "f004dfa1-4bc8-4a57-9eb6-9e76edf167f4"
      }
    },
    "owner": "elbiblio"
  }
}
