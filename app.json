{
  "expo": {
    "name": "El-Biblio",
    "slug": "elbiblio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/penheart.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ecefef"
    },
    "assetBundlePatterns": [
      "**/*",
      "./assets/bibles/rv.db",
      "./assets/bibles/versions.json",
      "./assets/sounds/streak.wav",
      "./assets/sounds/tick-tock.wav",
      "./assets/sounds/timeout.mp3",
      "./assets/sounds/game-over.mp3",
      "./assets/sounds/correct.mp3",
      "./assets/sounds/cheers.mp3"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.robosyslive.elbiblio"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/penheart.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.robosyslive.elbiblio"
    },
    "web": {
      "favicon": "./assets/penheart.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ]
  }
}
